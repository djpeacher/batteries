---
/**
 * The Local promise: one static line, the same on the Shelf and in every
 * Frame, in a bordered pill centred below the page's last block. At phone
 * width it wraps, and the pill becomes a rounded box.
 */
const shield = `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>`;
---
<footer class="local-promise">
  <p>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={shield} />
    <span>Runs entirely in your browser. Nothing you type or open leaves your device.</span>
  </p>
</footer>

<style>
  .local-promise { display: flex; justify-content: center; margin-top: 48px; }
  .local-promise p {
    display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 8px 14px;
    border: 1px solid var(--line); border-radius: 999px; background: var(--card);
    box-shadow: var(--shadow); color: var(--muted); font-size: 13px;
  }
  .local-promise svg { flex: none; }
  @media (max-width: 639px) { .local-promise p { border-radius: 12px; } }
</style>
