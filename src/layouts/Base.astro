---
/**
 * The base document every page is built on: head (title, Mark, fonts, theme),
 * colour tokens and the focus ring.
 */
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { THEME_KEY } from "../lib/theme";

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <!-- The Mark. Follows the OS, not the Theme toggle. -->
    <link rel="icon" type="image/svg+xml" href={`${base}mark-light.svg`} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href={`${base}mark-dark.svg`} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href={`${base}mark-tile.png`} />
    <!-- Applies the saved Light/Dark preference before first paint. System
         (no key) leaves data-theme off, and the CSS follows the OS. -->
    <script is:inline define:vars={{ key: THEME_KEY }}>
      try {
        var pref = localStorage.getItem(key);
        if (pref === "light" || pref === "dark") document.documentElement.dataset.theme = pref;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
