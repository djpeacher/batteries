---
/**
 * File Tree: the text side and the tree side, side by side under the
 * toolbar. What is typed on the text side is drawn on the tree side with the
 * `tree` command's lines, live on every input. The tree side can't be typed
 * into; with nothing to draw it shows the hint line. The toolbar holds the
 * mode control and Copy, which gives the tree side's text. The outline and
 * the mode are kept across a reload; a first visit shows the sample. An
 * outline too big to keep (or one the browser refuses to save) gets the size
 * notice at the bottom of the tree side.
 */
import Frame from "../../layouts/Frame.astro";
import * as meta from "./_meta";
import { icon } from "../../lib/html";
import { MODE_KEY } from "./_storage";
const textIcon = icon(`<path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>`);
const splitIcon = icon(`<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 3v18"/>`);
const copyIcon = icon(`<rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>`);
const treeIcon = icon(`<path d="M20 10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2.5a1 1 0 0 1-.8-.4l-.9-1.2A1 1 0 0 0 15 3h-2a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z"/><path d="M20 21a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1h-2.9a1 1 0 0 1-.88-.55l-.42-.85a1 1 0 0 0-.92-.6H13a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z"/><path d="M3 5a2 2 0 0 0 2 2h3"/><path d="M3 3v13a2 2 0 0 0 2 2h3"/>`);
const infoIcon = icon(`<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>`);
const modes = [
  { key: "split", label: "Split", icon: splitIcon },
  { key: "text", label: "Text", icon: textIcon },
  { key: "tree", label: "Tree", icon: treeIcon },
];
---
<Frame name={meta.name} blurb={meta.blurb}>
  <div class="ft" data-ft data-mode="split">
    <div class="ft-bar" role="group" aria-label="File Tree toolbar">
      <div class="segmented" role="group" aria-label="Mode">
        {modes.map((m) => (
          <button type="button" data-set-mode={m.key} aria-pressed={m.key === "split" ? "true" : "false"}>
            <Fragment set:html={m.icon} />{m.label}
          </button>
        ))}
      </div>
      <div class="ft-bar-end">
        <button type="button" class="ft-btn" data-copy disabled><Fragment set:html={copyIcon} />Copy</button>
      </div>
    </div>

    <div class="ft-sides">
      <section class="card ft-side ft-side-text" aria-label="Text side">
        <header class="ft-side-head"><Fragment set:html={textIcon} />Text</header>
        <textarea
          class="ft-text"
          data-text
          spellcheck="false"
          autocomplete="off"
          aria-label="Outline"
          placeholder="Type an indented outline."
        ></textarea>
      </section>
      <section class="card ft-side ft-side-tree" aria-label="Tree side">
        <header class="ft-side-head"><Fragment set:html={treeIcon} />Tree</header>
        <div class="ft-out" tabindex="0" aria-label="File tree">
          <div class="ft-drawing" data-drawing hidden></div>
          <p class="ft-hint" data-hint>Type an outline on the text side to draw it here.</p>
        </div>
        <div class="ft-notice" data-notice role="status" hidden><Fragment set:html={infoIcon} />Not kept after reload</div>
      </section>
    </div>
  </div>
  <!-- The saved mode, applied as soon as the markup above is parsed, so a page
       left in Text or Tree never paints Split first. The module script below
       takes over from here. -->
  <script is:inline define:vars={{ key: MODE_KEY }}>
    try {
      var mode = localStorage.getItem(key);
      if (mode === "text" || mode === "tree") {
        document.querySelector("[data-ft]").dataset.mode = mode;
        document.querySelectorAll("[data-set-mode]").forEach(function (b) {
          b.setAttribute("aria-pressed", String(b.dataset.setMode === mode));
        });
      }
    } catch (e) {}
  </script>
</Frame>

<script>
  import { draw, segments } from "./_draw";
  import { editDelay } from "../../scripts/delay";
  import { escapeHtml, icon } from "../../lib/html";
  import { wireTextBox } from "../../scripts/textbox";
  import { indenter } from "./_indent";
  import { loadMode, loadText, saveMode, saveText, type Mode } from "./_storage";

  const box = document.querySelector<HTMLTextAreaElement>("[data-text]")!;
  const drawing = document.querySelector<HTMLElement>("[data-drawing]")!;
  const hint = document.querySelector<HTMLElement>("[data-hint]")!;
  const root = document.querySelector<HTMLElement>("[data-ft]")!;
  const modeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-set-mode]")];
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy]")!;
  const notice = document.querySelector<HTMLElement>("[data-notice]")!;

  // The mode lives on the root as data-mode; CSS hides a side and widens the other.
  function showMode(mode: Mode) {
    root.dataset.mode = mode;
    for (const b of modeButtons) b.setAttribute("aria-pressed", String(b.dataset.setMode === mode));
  }
  showMode(loadMode());
  for (const b of modeButtons) {
    b.addEventListener("click", () => {
      const mode = b.dataset.setMode as Mode;
      saveMode(mode);
      showMode(mode);
    });
  }

  // A 2-column character (CJK, emoji) sits in a box exactly 2 columns wide:
  // fallback fonts draw it narrower than 2 Geist Mono columns, which would
  // pull the comment's # out of its column.
  function cells(s: string): string {
    if (/^[\x20-\x7e]*$/.test(s)) return escapeHtml(s);
    return segments(s)
      .map(({ text, wide }) => (wide ? `<span class="ft-wide">${escapeHtml(text)}</span>` : escapeHtml(text)))
      .join("");
  }

  // Each drawn line is one row: its muted tree lines, its name, then any
  // padding and its comment in the comment grey.
  function render() {
    pending = 0;
    const { lines } = draw(box.value);
    drawing.hidden = !lines.length;
    hint.hidden = !!lines.length;
    copyButton.disabled = !lines.length;
    drawing.innerHTML = lines
      .map(
        (l) =>
          `<div class="ft-line"><span class="ft-lines">${escapeHtml(l.prefix)}</span>${cells(l.name)}${
          l.comment ? `${l.pad}<span class="ft-comment">${escapeHtml(l.comment)}</span>` : ""
        }</div>`,
      )
      .join("");
  }

  // Live: every input is saved and redraws, at most once per frame however
  // fast it comes. An outline over about 1 MB waits for a pause in typing
  // first, with the shared threshold and delay; nothing marks the pause.
  let pending = 0;
  let waiting = 0;
  function scheduleRender() {
    clearTimeout(waiting);
    const delay = editDelay(box.value.length);
    if (delay) waiting = window.setTimeout(() => { if (!pending) pending = requestAnimationFrame(render); }, delay);
    else if (!pending) pending = requestAnimationFrame(render);
  }
  // The size notice shows while the last save didn't keep the outline, and
  // goes away by itself once a save succeeds.
  box.addEventListener("input", () => {
    notice.hidden = saveText(box.value);
    scheduleRender();
  });

  // Copy gives the drawing's text, read fresh so a redraw still waiting for
  // its frame can't leave it a keystroke behind. A selection on the tree side
  // is left to the browser's own copy: every drawn character is in the page.
  // After copying, the button shows a green tick and "Copied" for 1.5 s.
  const copyLabel = copyButton.innerHTML;
  const copiedLabel = `${icon(`<path d="M20 6 9 17l-5-5"/>`)}Copied`;
  let copiedTimer = 0;
  copyButton.addEventListener("click", async () => {
    const { text } = draw(box.value);
    if (!text) return;
    await navigator.clipboard.writeText(text);
    clearTimeout(copiedTimer);
    copyButton.innerHTML = copiedLabel;
    copyButton.classList.add("is-copied");
    copiedTimer = window.setTimeout(() => {
      copyButton.innerHTML = copyLabel;
      copyButton.classList.remove("is-copied");
    }, 1500);
  });

  box.value = loadText();
  // Tab and Shift-Tab move whole lines an indent step, which holds through a
  // run of presses; Enter carries the indentation.
  wireTextBox(box, indenter());
  render();
  if (!box.value) box.focus();
</script>

<style>
  .ft-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-height: 36px; margin-bottom: 12px; }
  .ft-bar-end { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  /* Copy: bordered, at the toolbar's right, as Pretty Print's. */
  .ft-btn {
    display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px;
    border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--fg);
    font: inherit; font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  .ft-btn:hover:not(:disabled) { background: var(--tint); }
  .ft-btn:disabled { color: var(--muted); cursor: default; box-shadow: none; opacity: 0.6; }
  .ft-btn :global(svg) { flex: none; }
  .ft-btn.is-copied { color: var(--hl-tag); }

  /* The page never scrolls: the column is exactly the window's height,
     ending 24px under the Local promise, and the two sides take whatever
     the header, toolbar and promise leave. */
  :global(main.column) { display: flex; flex-direction: column; height: 100dvh; padding-bottom: 24px; }
  .ft { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .ft-sides {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px;
    flex: 1; min-height: 0;
  }
  .ft-side { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .ft-side-head {
    flex: none; display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px;
    border-bottom: 1px solid var(--line); font-size: 12px; font-weight: 500; color: var(--muted);
  }
  .ft-side-head :global(svg) { flex: none; }

  /* The text side: a borderless mono textarea, as Pretty Print's. */
  .ft-text {
    flex: 1; display: block; width: 100%; min-height: 0; margin: 0; padding: 16px 18px;
    border: 0; resize: none; background: transparent; color: var(--fg);
    font: 13px/1.7 var(--font-mono); tab-size: 4;
  }
  .ft-text::placeholder { color: var(--muted); opacity: 1; }
  .ft-text:focus-visible, .ft-out:focus-visible { outline-offset: -2px; border-radius: 0 0 11px 11px; }

  /* The tree side: one line per row, never wrapped, scrolling both ways. */
  .ft-out { flex: 1; min-height: 0; overflow: auto; }
  .ft-drawing {
    width: max-content; min-width: 100%; box-sizing: border-box; padding: 16px 18px;
    font: 13px/1.7 var(--font-mono); white-space: pre; color: var(--fg);
  }
  .ft-drawing :global(.ft-lines) { color: var(--muted); opacity: 0.7; }
  .ft-drawing :global(.ft-comment) { color: var(--hl-comment); }
  .ft-drawing :global(.ft-wide) { display: inline-block; width: 2ch; text-align: center; }
  .ft-drawing[hidden], .ft-hint[hidden] { display: none; }

  /* The size notice: Pretty Print's 34px footer pinned under the tree side's
     drawing, muted on the tint, with no button. The drawing shrinks above it. */
  .ft-notice {
    flex: none; display: flex; align-items: center; gap: 8px; min-height: 34px; padding: 0 8px 0 14px;
    border-top: 1px solid var(--line); background: var(--tint); color: var(--muted); font-size: 12px;
  }
  .ft-notice :global(svg) { flex: none; }
  .ft-notice[hidden] { display: none; }

  /* The hint line: where the first drawn line will appear, so nothing jumps. */
  .ft-hint { margin: 0; padding: 16px 18px; color: var(--muted); font-size: 13px; line-height: 1.7; }

  /* One side hidden: the other takes the full width. */
  .ft:not([data-mode="split"]) .ft-sides { grid-template-columns: minmax(0, 1fr); }
  .ft[data-mode="text"] .ft-side-tree,
  .ft[data-mode="tree"] .ft-side-text { display: none; }

  /* Phone: split stacks the text side above the tree side, each half of the
     same height, each scrolling on its own. */
  @media (max-width: 639px) {
    .ft[data-mode="split"] .ft-sides { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); }
  }
</style>
