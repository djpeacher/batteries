---
/** The Shelf: every battery, alphabetically, as Stacked row Shelf entries. */
import Shelf from "../layouts/Shelf.astro";
import { batteries } from "../lib/batteries";
---
<Shelf title="Batteries — Batteries Included" heading="Batteries" tagline="Batteries Included">
  <ul class="card shelf" role="list">
    {batteries.map((b) => (
      <li>
        <a class="shelf-entry" href={b.href}>
          <span class="shelf-entry-text">
            <span class="shelf-entry-name">{b.name}</span>
            <span class="shelf-entry-blurb">{b.blurb}</span>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>
      </li>
    ))}
  </ul>
</Shelf>

<style>
  .shelf { list-style: none; margin: 0; padding: 0; }
  .shelf li + li { border-top: 1px solid var(--line); }
  .shelf-entry { display: flex; align-items: center; gap: 16px; padding: 14px 16px; transition: background 0.12s; }
  /* Keep the ring inside the card, which clips its overflow. */
  .shelf-entry:focus-visible { outline-offset: -2px; border-radius: 11px; }
  .shelf-entry:hover { background: var(--tint); }
  .shelf-entry-text { flex: 1; min-width: 0; }
  .shelf-entry-name { display: block; font-weight: 500; }
  .shelf-entry-blurb { display: block; color: var(--muted); font-size: 13px; }
  .shelf-entry svg { flex: none; color: var(--muted); transition: transform 0.15s, color 0.15s; }
  .shelf-entry:hover svg { transform: translateX(3px); color: var(--fg); }
</style>
