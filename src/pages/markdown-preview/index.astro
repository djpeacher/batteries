---
/**
 * Markdown Preview: the text side and the rendered side, side by side under
 * the toolbar, rendered live on every input. The document is saved locally.
 * A file dropped anywhere, or picked with Open…, replaces the document.
 * Mermaid blocks are drawn on diagram canvases in the theme on screen.
 */
import Frame from "../../layouts/Frame.astro";
import * as meta from "./_meta";
import { MODE_KEY } from "./_storage";
import { icon } from "../../lib/html";
const textIcon = icon(`<path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>`);
const renderedIcon = icon(`<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>`);
const splitIcon = icon(`<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 3v18"/>`);
const openIcon = icon(`<path d="m6 14 1.5-2.9A2 2 0 0 1 9.2 10H20a2 2 0 0 1 1.9 2.5l-1.5 6A2 2 0 0 1 18.4 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.7.9l.8 1.2a2 2 0 0 0 1.7.9H18a2 2 0 0 1 2 2v2"/>`);
const uploadIcon = icon(`<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>`, 22);
const modes = [
  { key: "split", label: "Split", icon: splitIcon },
  { key: "text", label: "Text", icon: textIcon },
  { key: "rendered", label: "Rendered", icon: renderedIcon },
];
---
<Frame name={meta.name} blurb={meta.blurb}>
  <div class="mp" data-mp data-mode="split">
    <div class="mp-bar" role="group" aria-label="Markdown Preview toolbar">
      <div class="segmented" role="group" aria-label="Mode">
        {modes.map((m) => (
          <button type="button" data-set-mode={m.key} aria-pressed={m.key === "split" ? "true" : "false"}>
            <Fragment set:html={m.icon} />{m.label}
          </button>
        ))}
      </div>
      <div class="mp-bar-end">
        <button type="button" class="mp-open" data-open><Fragment set:html={openIcon} />Open…</button>
      </div>
    </div>

    <div class="mp-sides">
      <section class="card mp-side mp-side-text" aria-label="Text side">
        <header class="mp-side-head"><Fragment set:html={textIcon} />Text</header>
        <textarea
          class="mp-text"
          data-text
          spellcheck="false"
          autocomplete="off"
          aria-label="Markdown text"
          placeholder="Type or paste markdown, or drop a file."
        ></textarea>
      </section>
      <section class="card mp-side mp-side-rendered" aria-label="Rendered side">
        <header class="mp-side-head"><Fragment set:html={renderedIcon} />Rendered</header>
        <div class="mp-rendered" data-rendered></div>
      </section>
      <div class="mp-drop" aria-hidden="true">
        <div><Fragment set:html={uploadIcon} /><strong>Drop to open</strong>Replaces the current text</div>
      </div>
    </div>
    <input type="file" accept=".md,.markdown,.txt,text/markdown,text/plain" data-file hidden />
  </div>
  <!-- The saved mode, applied as soon as the markup above is parsed, so a page
       left in Text or Rendered never paints Split first. The module script
       below takes over from here. -->
  <script is:inline define:vars={{ key: MODE_KEY }}>
    try {
      var mode = localStorage.getItem(key);
      if (mode === "text" || mode === "rendered") {
        document.querySelector("[data-mp]").dataset.mode = mode;
        document.querySelectorAll("[data-set-mode]").forEach(function (b) {
          b.setAttribute("aria-pressed", String(b.dataset.setMode === mode));
        });
      }
    } catch (e) {}
  </script>
</Frame>

<script>
  import { renderMarkdown } from "./_markdown";
  import { loadMode, loadText, saveMode, saveText, type Mode } from "./_storage";
  import { replaceText, wireTextBox } from "../../scripts/textbox";
  import { wireFileDrop } from "../../scripts/filedrop";
  import { phone } from "../../scripts/phone";
  import { wireScrollSync } from "./_scrollsync";
  import { fillDiagrams } from "./_diagrams";
  import { fillMath } from "./_math";
  import { currentTheme, onThemeChange } from "../../scripts/theme";

  const box = document.querySelector<HTMLTextAreaElement>("[data-text]")!;
  const rendered = document.querySelector<HTMLElement>("[data-rendered]")!;
  const root = document.querySelector<HTMLElement>("[data-mp]")!;
  const modeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-set-mode]")];
  const sync = wireScrollSync(box, rendered);
  // Scroll sync runs only in split on desktop widths: at phone width the sides stack.
  const syncIfSplit = () => sync.setActive(root.dataset.mode === "split" && !phone.matches);
  phone.addEventListener("change", syncIfSplit);

  // The mode lives on the root as data-mode; CSS hides a side and widens the other.
  function showMode(mode: Mode) {
    root.dataset.mode = mode;
    for (const b of modeButtons) b.setAttribute("aria-pressed", String(b.dataset.setMode === mode));
    syncIfSplit();
  }
  showMode(loadMode());
  for (const b of modeButtons) {
    b.addEventListener("click", () => {
      const mode = b.dataset.setMode as Mode;
      saveMode(mode);
      showMode(mode);
    });
  }

  // The 80-column ruler is hidden while the document is empty.
  const markEmpty = () => root.toggleAttribute("data-empty", !box.value);

  // Live: every input renders, at most once per frame however fast it comes.
  let pending = 0;
  function render() {
    pending = 0;
    rendered.innerHTML = renderMarkdown(box.value);
    // Diagrams drawn and formulas typeset before now are back already; new
    // ones land later and change the heights scroll sync measured.
    const late = [fillDiagrams(rendered, currentTheme()), fillMath(rendered)];
    sync.refresh();
    for (const filled of late) filled.then((changed) => changed && sync.refresh());
  }
  function scheduleRender() {
    if (!pending) pending = requestAnimationFrame(render);
  }

  box.value = loadText();
  wireTextBox(box);
  // Typing, paste and Cmd-Z all arrive here as native edits.
  box.addEventListener("input", () => {
    saveText(box.value);
    markEmpty();
    scheduleRender();
  });
  markEmpty();
  render();
  // Diagrams are drawn in the theme on screen, so a theme change redraws them.
  onThemeChange(scheduleRender);
  // An empty document: the caret is already in the text side.
  if (!box.value) box.focus();

  // Open… and drop: read the file here, in the browser (nothing is
  // uploaded), and replace the document as one native edit, so Cmd-Z brings the previous text back.
  // Rendered only hides the text side, and a hidden box can't take the edit:
  // show it for the moment of the edit, then hide it again.
  async function open(file: File | undefined) {
    if (!file) return;
    const text = await file.text();
    const hidden = root.dataset.mode === "rendered";
    if (hidden) root.dataset.mode = "text";
    replaceText(box, text);
    if (hidden) {
      root.dataset.mode = "rendered";
      box.blur();
    }
  }
  const fileInput = document.querySelector<HTMLInputElement>("[data-file]")!;
  document.querySelector<HTMLButtonElement>("[data-open]")!.addEventListener("click", () => {
    fileInput.value = "";
    fileInput.click();
  });
  fileInput.addEventListener("change", () => open(fileInput.files?.[0]));

  // A file dragged anywhere over the battery: one overlay across both sides.
  wireFileDrop({
    onDrag: (on) => root.toggleAttribute("data-dragging", on),
    onDrop: (file) => open(file),
  });
</script>

<style>
  .mp-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-height: 36px; margin-bottom: 12px; }
  .mp-bar-end { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  /* Open…: bordered, at the toolbar's right. */
  .mp-open {
    display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px;
    border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--fg);
    font: inherit; font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  .mp-open:hover { background: var(--tint); }
  .mp-open :global(svg) { flex: none; }

  /* The page never scrolls: the column is exactly the window's height,
     ending 24px under the Local promise, and the two sides take whatever
     the header, toolbar and promise leave. */
  :global(main.column) { display: flex; flex-direction: column; height: 100dvh; padding-bottom: 24px; }
  .mp { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .mp-sides {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px;
    flex: 1; min-height: 0;
  }
  .mp-side { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .mp-side-head {
    flex: none; display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px;
    border-bottom: 1px solid var(--line); font-size: 12px; font-weight: 500; color: var(--muted);
  }
  .mp-side-head :global(svg) { flex: none; }

  /* The text side: a borderless mono textarea, no gutter, no tinting. */
  .mp-text {
    flex: 1; display: block; width: 100%; min-height: 0; margin: 0; padding: 16px 18px;
    border: 0; resize: none; background: transparent; color: var(--fg);
    font: 13px/1.7 var(--font-mono); tab-size: 4;
  }
  /* Text only: a faint ruler at 80 columns (after the 18px padding), scrolling
     with the text, gone while the document is empty. */
  .mp[data-mode="text"]:not([data-empty]) .mp-text {
    background: linear-gradient(var(--line), var(--line)) no-repeat local;
    background-size: 1px 100%; background-position: calc(18px + 80ch) 0;
  }
  .mp-text::placeholder { color: var(--muted); opacity: 1; }
  .mp-text:focus-visible { outline-offset: -2px; border-radius: 0 0 11px 11px; }

  .mp-rendered { flex: 1; min-height: 0; overflow: auto; }

  /* A file dragged over the battery: a dashed overlay across both sides. */
  .mp-drop {
    display: none; position: absolute; inset: 0; z-index: 2; place-items: center; padding: 16px;
    border: 2px dashed var(--muted); border-radius: 12px; text-align: center;
    background: color-mix(in srgb, var(--bg) 88%, transparent); color: var(--muted); font-size: 13px;
    pointer-events: none;
  }
  .mp-drop strong { display: block; margin: 8px 0 2px; color: var(--fg); font-size: 15px; font-weight: 600; }
  .mp[data-dragging] .mp-drop { display: grid; }
  .mp-rendered:focus-visible { outline-offset: -2px; }

  /* One side hidden: the other takes the full width. */
  .mp:not([data-mode="split"]) .mp-sides { grid-template-columns: minmax(0, 1fr); }
  .mp[data-mode="text"] .mp-side-rendered,
  .mp[data-mode="rendered"] .mp-side-text { display: none; }

  /* Phone: split stacks the text side above the rendered side, each half
     of the same height, each scrolling on its own. */
  @media (max-width: 639px) {
    .mp[data-mode="split"] .mp-sides { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); }
  }
</style>

<style is:global>
  /* ---- The rendered side: GitHub's README typography -------------------- */
  .mp-rendered { padding: 24px 28px; font: 15px/1.6 var(--font-sans); color: var(--fg); overflow-wrap: break-word; }
  .mp-rendered > :first-child { margin-top: 0 !important; }
  .mp-rendered > :last-child { margin-bottom: 0 !important; }
  .mp-rendered :is(h1, h2, h3, h4, h5, h6) { font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; margin: 24px 0 16px; }
  .mp-rendered h1 { font-size: 28px; padding-bottom: 0.3em; border-bottom: 1px solid var(--line); }
  .mp-rendered h2 { font-size: 22px; padding-bottom: 0.3em; border-bottom: 1px solid var(--line); }
  .mp-rendered h3 { font-size: 18px; }
  .mp-rendered h4 { font-size: 15px; }
  .mp-rendered h5 { font-size: 14px; }
  .mp-rendered h6 { font-size: 13px; color: var(--muted); }
  .mp-rendered :is(p, ul, ol, blockquote, .md-table, pre, .md-diagram, .md-math-display, details, dl) { margin: 0 0 16px; }
  .mp-rendered :is(ul, ol) { padding-left: 2em; }
  .mp-rendered :is(ul, ol) :is(ul, ol) { margin-bottom: 0; }
  .mp-rendered li + li { margin-top: 0.25em; }
  .mp-rendered a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .mp-rendered strong { font-weight: 600; }
  .mp-rendered blockquote { margin-left: 0; margin-right: 0; padding: 0 1em; border-left: 4px solid var(--line); color: var(--muted); }
  .mp-rendered :not(pre) > code { font: 85% var(--font-mono); background: var(--tint); padding: 0.2em 0.4em; border-radius: 6px; }
  .mp-rendered kbd {
    display: inline-block; padding: 3px 5px; font: 11px/10px var(--font-mono); vertical-align: middle; color: var(--fg);
    background: var(--tint); border: 1px solid var(--line); border-radius: 6px; box-shadow: inset 0 -1px 0 var(--line);
  }
  .mp-rendered hr { height: 4px; margin: 24px 0; border: 0; background: var(--line); }
  .mp-rendered img { max-width: 100%; }
  .mp-rendered .md-table { overflow-x: auto; }
  .mp-rendered table { border-collapse: collapse; font-size: 14px; }
  .mp-rendered :is(th, td) { border: 1px solid var(--line); padding: 6px 13px; }
  .mp-rendered th { font-weight: 600; }
  .mp-rendered tbody tr:nth-child(2n) { background: var(--tint); }
  .mp-rendered .task-list-item { list-style: none; }
  .mp-rendered .task-list-item input { margin: 0 0.3em 0.25em -1.4em; vertical-align: middle; }
  .mp-rendered details > summary { cursor: pointer; }

  /* Rendered only: the text in a centred 880px column. The side margins sit on
     each top-level block, whose percentages resolve inside the scrollbar, so
     the column stays 880px whether or not the scrollbar takes room. */
  .mp[data-mode="rendered"] .mp-rendered { padding: 32px 0; }
  .mp[data-mode="rendered"] .mp-rendered > * { margin-inline: max(28px, calc((100% - 880px) / 2)); }

  /* ---- Code blocks: tinted, borderless, unlabelled, scrolling sideways --- */
  .mp-rendered pre { overflow: auto; padding: 16px; border-radius: 6px; background: var(--tint); font: 85%/1.45 var(--font-mono); white-space: pre; }
  .mp-rendered pre code { font: inherit; background: none; padding: 0; border: 0; color: inherit; }

  /* ---- Diagram canvas: bordered, a 14px dotted grid following the theme,
     the drawing centred. Wide drawings scroll sideways. ------------------ */
  .mp-rendered .md-diagram {
    display: flex; justify-content: center; overflow-x: auto; padding: 24px 16px;
    border: 1px solid var(--line); border-radius: 10px;
    background: radial-gradient(var(--line) 1px, transparent 1px) 0 0 / 14px 14px, var(--card);
  }
  .mp-rendered .md-diagram > svg { flex: none; max-width: 100%; height: auto; }

  /* ---- Math: display math centred on its own line (KaTeX centres it),
     scrolling sideways when too wide; inline math sits in the line. ------- */
  .mp-rendered .md-math-display { overflow-x: auto; overflow-y: hidden; }
  .mp-rendered .md-math-display .katex-display { margin: 0; }
  .mp-rendered .katex { font-size: 1.1em; }
  /* A formula KaTeX can't parse shows its source in KaTeX's red (an inline
     style, #cc0000). That red is under 4.5:1 on the dark background, so dark
     swaps in the diagram error's red. */
  .mp-rendered .katex-error { color: light-dark(#cc0000, #f87171) !important; }

  /* ---- Diagram error: a console panel, dark in both themes (zinc-900 in
     light, black in dark). Its red line is exempt from the zinc-only rule. */
  .mp-rendered .md-diagram.is-error { display: block; padding: 0; border: 0; background: none; }
  .mp-rendered .md-diagram-error {
    padding: 14px 16px; border: 1px solid #27272a; border-radius: 10px; background: light-dark(#18181b, #000);
    font: 13px/1.6 var(--font-mono); color: #e4e4e7;
  }
  .mp-rendered .md-diagram-error strong { display: block; font-weight: 500; color: #f87171; }
  .mp-rendered .md-diagram-error pre {
    margin: 4px 0 0; padding: 0; border-radius: 0; background: none; color: #a1a1aa;
    font: 12.5px/1.6 var(--font-mono); white-space: pre-wrap;
  }

  /* ---- Stock GitHub syntax colours (highlight.js github / github-dark),
     following the site theme. Exempt from the zinc-only rule. ------------- */
  :root {
    --hl-keyword: light-dark(#d73a49, #ff7b72); --hl-entity: light-dark(#6f42c1, #d2a8ff);
    --hl-constant: light-dark(#005cc5, #79c0ff); --hl-string: light-dark(#032f62, #a5d6ff);
    --hl-variable: light-dark(#e36209, #ffa657); --hl-comment: light-dark(#6a737d, #8b949e);
    --hl-tag: light-dark(#22863a, #7ee787); --hl-heading: light-dark(#005cc5, #1f6feb);
    --hl-list: light-dark(#735c0f, #f2cc60); --hl-ins: light-dark(#22863a, #aff5b4);
    --hl-ins-bg: light-dark(#f0fff4, #033a16); --hl-del: light-dark(#b31d28, #ffdcd7);
    --hl-del-bg: light-dark(#ffeef0, #67060c);
  }
  .hljs :is(.hljs-doctag, .hljs-keyword, .hljs-template-tag, .hljs-template-variable, .hljs-type, .hljs-variable.language_),
  .hljs .hljs-meta .hljs-keyword { color: var(--hl-keyword); }
  .hljs :is(.hljs-title, .hljs-title.class_, .hljs-title.function_) { color: var(--hl-entity); }
  .hljs :is(.hljs-attr, .hljs-attribute, .hljs-literal, .hljs-meta, .hljs-number, .hljs-operator, .hljs-variable, .hljs-selector-attr, .hljs-selector-class, .hljs-selector-id) { color: var(--hl-constant); }
  .hljs :is(.hljs-regexp, .hljs-string),
  .hljs .hljs-meta .hljs-string { color: var(--hl-string); }
  .hljs :is(.hljs-built_in, .hljs-symbol) { color: var(--hl-variable); }
  .hljs :is(.hljs-comment, .hljs-code, .hljs-formula) { color: var(--hl-comment); }
  .hljs :is(.hljs-name, .hljs-quote, .hljs-selector-tag, .hljs-selector-pseudo) { color: var(--hl-tag); }
  .hljs .hljs-subst { color: inherit; }
  .hljs .hljs-section { color: var(--hl-heading); font-weight: bold; }
  .hljs .hljs-bullet { color: var(--hl-list); }
  .hljs .hljs-emphasis { font-style: italic; }
  .hljs .hljs-strong { font-weight: bold; }
  .hljs .hljs-addition { color: var(--hl-ins); background: var(--hl-ins-bg); }
  .hljs .hljs-deletion { color: var(--hl-del); background: var(--hl-del-bg); }
</style>
